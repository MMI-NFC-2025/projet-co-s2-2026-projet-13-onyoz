---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import bgImage from "../assets/bg_landingpage.avif";
import Txtlogo from "../assets/icons/logo_footer.svg";
---

<Layout>
    <div
        class="relative flex justify-center w-full max-lg:h-125 lg:-top-40 z-0"
    >
        <Image
            src={bgImage}
            alt="image de fond décorative d'une carte de montbéliard"
            class="object-cover object-center w-full h-full"
        />
    </div>
    <div class="grid-custom w-full h-full">
        <div
            class="w-full h-full absolute top-0 col-start-1 items-center justify-center z-10"
        >
            <Txtlogo class="absolute top-40 h-75 w-full" />
        </div>
        <p
            class="absolute top-103 right-50 text-white text-4xl font-poppins font-light z-10"
        >
            On épluche les bons plans pour vous !
        </p>
        <button>
            <a
                href="#"
                class="absolute top-130 right-90 text-white text-3xl font-poppins z-10 bg-vert rounded-xl font-bold px-8 py-4 transition-all duration-300 ease-in-out hover:bg-white hover:text-rouge"
            >
                → Allons y !
            </a>
        </button>
    </div>
    <p>bla</p>
</Layout>
