---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import bgImage from "../assets/bg_landingpage.avif";
import Txtlogo from "../assets/icons/logo_txt.svg";
---

<Layout>
    <div
        class="relative flex justify-center w-full max-lg:h-125 lg:-top-40 z-0"
    >
        <Image
            src={bgImage}
            alt="image de fond décorative d'une carte de montbéliard"
            class="object-cover object-center w-full h-full"
        />
    </div>
    <div
        class="grid-custom lg:w-full lg:h-full max-lg:flex max-lg:flex-col max-lg:items-center"
    >
        <div
            class="h-full absolute top-0 lg:col-start-2 items-center justify-center z-10"
        >
            <Txtlogo
                class="absolute top-40 lg:h-75 lg:w-200 max-lg:h-35 max-lg:w-auto max-lg:justify-center"
            />
        </div>
        <p
            class="absolute top-103 lg:col-start-6 text-white text-4xl font-poppins font-light z-10"
        >
            On épluche les bons plans pour vous !
        </p>
        <button class="lg:col-start-8">
            <a
                href="#"
                class="absolute top-130 text-white text-3xl font-poppins z-10 bg-vert rounded-xl font-bold px-8 py-4 transition-all duration-300 ease-in-out hover:bg-white hover:text-rouge"
            >
                → Allons y !
            </a>
        </button>
    </div>
    <p>bla</p>
</Layout>
