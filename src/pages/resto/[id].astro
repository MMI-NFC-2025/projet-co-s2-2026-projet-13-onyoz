---
import Layout from '../../layouts/Layout.astro';
import RestoHero from '../../components/resto/RestoHero.astro';
import RestoInfo from '../../components/resto/RestoInfo.astro';
import RestoMap from '../../components/resto/RestoMap.astro';
import RestoMenu from '../../components/resto/RestoMenu.astro';
import RestoReviews from '../../components/resto/RestoReviews.astro';
import { getRestaurantById, getAvisByRestaurantId } from '../../backend.mjs';

const { id } = Astro.params;
const resto = await getRestaurantById(id);
const avis = await getAvisByRestaurantId(id);
---

<Layout title={resto.nom_restaurants}>
  
  <main class="min-h-screen bg-neutral-200 flex justify-center pb-10">
    <section class="w-full max-w-[390px] bg-white text-neutral-900">
      
      <RestoHero resto={resto} />
      
      <article class="px-4 py-5 space-y-6">
        <RestoInfo resto={resto} />
        <RestoMap resto={resto} />
        <RestoMenu resto={resto} />
        <RestoReviews avis={avis} />
      </article>

    </section>
  </main>
  
</Layout>