---
import Layout from '../layouts/Layout.astro';
import MapSection from '../components/map/MapSection.astro';
import Resto from '../components/map/resto.astro';
import { getRestaurantsPrixCroissant } from '../backend.mjs';

const restaurants = await getRestaurantsPrixCroissant();
---

<Layout title="Onyoz - La Carte">
  
  <div class="fixed inset-0 w-full h-full z-0">
    <MapSection />
  </div>

  <div class="relative z-10 w-full min-h-screen pt-[50vh]">
    
    <main class="w-full max-w-md mx-auto px-4 pb-12">
     

      <div class="space-y-4">
        {restaurants.map((r) => <Resto resto={r} />)}
      </div>

    </main>

    <footer class="bg-bordeaux p-8 text-white mt-10">
       <p>Onyoz - Footer</p>
    </footer>

  </div>

</Layout>

<style is:global>
  html, body {
    background: transparent;
  }
</style>