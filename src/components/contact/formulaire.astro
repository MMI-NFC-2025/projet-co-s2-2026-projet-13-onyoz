---
import ellipse from "../../assets/Group 22(1).svg";
const { title = "Formulaire de contact" } = Astro.props;
---

<section class="relative bg-beige px-6 pt-16 md:pt-24 overflow-hidden">
  <!-- Cercles décoratifs haut-droite -->
  <img
    src={ellipse.src}
    aria-hidden="true"
    class="absolute -top-16 -right-16 w-80 opacity-40 pointer-events-none select-none"
  />
  <h1 class="relative z-10 text-center font-kodchasan text-4xl md:text-5xl text-noir">
    {title}
  </h1>
</section>