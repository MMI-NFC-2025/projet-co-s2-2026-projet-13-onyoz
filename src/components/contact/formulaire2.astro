---
import grosOignon from "../../assets/gors nonion(1).svg";
const { onSubmit = "#" } = Astro.props;
---

<section class="formulaire-section">
    <img src={grosOignon.src} aria-hidden="true" class="deco" />
    <form action={onSubmit}>
        <div class="ligne-2col">
            <div class="champ">
                <label for="nom">Nom</label>
                <input id="nom" type="text" placeholder="Ex : Meyer" />
            </div>
            <div class="champ">
                <label for="prenom">Prénom</label>
                <input id="prenom" type="text" placeholder="Ex : Emma" />
            </div>
        </div>
        <div class="champ">
            <label for="email">Email</label>
            <input id="email" type="email" placeholder="Ex : emma.meyer@gmail.com" />
        </div>
        <div class="champ">
            <label for="objet">Objet</label>
            <input id="objet" type="text" placeholder="Ex : Informations erronées" />
        </div>
        <div class="champ">
            <label for="message">Message</label>
            <textarea id="message" rows="7" placeholder="Écrivez votre message ici.."></textarea>
        </div>
        <div class="envoyer">
            <button type="submit">→ Envoyer</button>
        </div>
    </form>
</section>

<style>
.formulaire-section {
    position: relative;
    background-color: var(--color-beige);
    padding: 1rem 1.5rem 5rem;
    overflow: hidden;
}

.deco {
    position: absolute;
    bottom: -5rem;
    left: -5rem;
    width: 18rem;
    opacity: 0.3;
    pointer-events: none;
}

form {
    position: relative;
    z-index: 10;
    max-width: 56rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.ligne-2col {
    display: grid;
    gap: 1rem;
}

.champ {
    display: flex;
    flex-direction: column;
}

label {
    font-family: var(--font-kodchasan);
    font-size: 1.25rem;
    color: var(--color-noir);
    margin-bottom: 0.5rem;
}

input,
textarea {
    width: 100%;
    border: 1px solid rgba(136, 39, 42, 0.4);
    background-color: var(--color-beige);
    padding: 0.5rem 1rem;
    border-radius: 2px;
    outline: none;
    font-family: var(--font-poppins);
    box-sizing: border-box;
}

input::placeholder,
textarea::placeholder {
    font-style: italic;
    color: rgba(91, 79, 75, 0.5);
}

input:focus,
textarea:focus {
    border-color: var(--color-vert);
}

.envoyer {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
}

button[type="submit"] {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--color-vert);
    color: white;
    font-family: var(--font-kodchasan);
    font-size: 1.25rem;
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 2px;
    cursor: pointer;
}

button[type="submit"]:hover {
    filter: brightness(0.95);
}

@media (min-width: 768px) {
    .ligne-2col { grid-template-columns: 1fr 1fr; }
}
</style>