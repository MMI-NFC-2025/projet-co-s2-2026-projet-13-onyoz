---
import LogoTxt from "../../assets/icons/logo_noir.svg";
import group21 from "../../assets/landing_page/group21.avif";
import grosOignon from "../../assets/gors nonion(1).svg";
import ellipse17 from "../../assets/Group 22(1).svg";
---

<section class="qso-section">
    <img src={grosOignon.src} aria-hidden="true" class="deco-gauche" />
    <img src={ellipse17.src} aria-hidden="true" class="deco-droite" />

    <div class="qso-inner">
        <h2 class="qso-titre">
            Qu'est-ce que c'est <LogoTxt class="logo-inline" /> ?
        </h2>

        <!-- Desktop : image -->
        <div class="qso-desktop">
            <img src={group21.src} alt="Map interactive, offres étudiantes et filtres" />
        </div>

        <!-- Mobile : 3 cartes -->
        <div class="qso-mobile">
            <div class="carte carte-gauche">
                <p><strong>Offres étudiantes</strong><br />et<br /><strong>bons plans</strong><br />mis en avant !</p>
            </div>
            <div class="carte carte-centre">
                <h3>Map interactive</h3>
                <p>pour trouver les établissements à proximité !</p>
            </div>
            <div class="carte carte-droite">
                <p>De<br /><strong>nombreux filtres</strong><br />pour trouver ce qu'il vous faut !</p>
            </div>
        </div>
    </div>
</section>

<style>
.qso-section {
    position: relative;
    padding: 5rem 1.5rem;
    background-color: var(--color-beige);
    overflow: hidden;
}

.deco-gauche {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    width: 237px;
}

.deco-droite {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    width: 384px;
}

.qso-inner {
    max-width: 64rem;
    margin: 0 auto;
    position: relative;
}

.qso-titre {
    text-align: center;
    font-family: var(--font-kodchasan);
    font-weight: 700;
    font-size: 1.875rem;
    margin-bottom: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.logo-inline {
    height: 2.5rem;
    display: inline-block;
}

.qso-desktop {
    display: none;
}

.qso-desktop img {
    width: 100%;
    max-width: 48rem;
    object-fit: contain;
    margin: 0 auto;
    display: block;
}

.qso-mobile {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: 48rem;
    margin: 0 auto;
}

.carte {
    flex: 1;
    background-color: var(--color-blanc);
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    font-family: var(--font-poppins);
    font-size: 0.875rem;
}

.carte h3 {
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
}

.carte-gauche {
    border-left: 4px solid var(--color-vert);
    margin-top: 3rem;
}

.carte-centre {
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.15);
    border-bottom: 4px solid var(--color-rouge);
    z-index: 10;
}

.carte-droite {
    border-right: 4px solid var(--color-vert);
    margin-top: 3rem;
    text-align: right;
}

@media (min-width: 1024px) {
    .qso-desktop { display: flex; justify-content: center; }
    .qso-mobile { display: none; }
    .qso-titre { font-size: 2.25rem; }
    .logo-inline { height: 3.5rem; }
}
</style>
