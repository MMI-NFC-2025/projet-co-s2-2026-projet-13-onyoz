---
import LogoTxt from "../../assets/icons/logo_noir.svg";
import group21 from "../../assets/landing_page/group21.avif";
import grosOignon from "../../assets/gors nonion(1).svg";
import ellipse17 from "../../assets/Group 22(1).svg";
---

<section class="relative py-20 px-6 bg-beige overflow-hidden">
    <!-- Decorative rings left -->
    <img
        src={grosOignon.src}
        width={237}
        height={474}
        aria-hidden="true"
        class="absolute left-0 top-1/2 -translate-y-1/2 pointer-events-none select-none"
    />

    <!-- Decorative rings right -->
    <img
        src={ellipse17.src}
        width={384}
        height={384}
        aria-hidden="true"
        class="absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none select-none"
    />

    <div class="max-w-5xl mx-auto relative">
        <h2
            class="text-center font-kodchasan font-bold text-3xl lg:text-4xl mb-16 flex items-center justify-center gap-2 flex-wrap"
        >
            Quesque c'est <LogoTxt class="h-10 lg:h-14 inline-block" /> ?
        </h2>

        <!-- Desktop: image composée des 3 cartes -->
        <div class="hidden lg:flex justify-center">
            <img
                src={group21.src}
                alt="Map interactive, offres étudiantes et filtres"
                class="w-full max-w-3xl object-contain"
            />
        </div>

        <!-- Mobile: cartes en éventail -->
        <div class="flex lg:hidden justify-center gap-3 items-start max-w-3xl mx-auto">
            <!-- Carte gauche : décalée vers le bas -->
            <div class="flex-1 bg-blanc rounded-2xl shadow-md p-4 border-l-4 border-vert mt-12">
                <p class="font-poppins text-sm leading-loose">
                    <strong>Offres etudiantes</strong><br />
                    et<br />
                    <strong class="text-base">bons plans</strong><br />
                    mis en avant !
                </p>
            </div>
            <!-- Carte centre : en avant -->
            <div class="flex-1 z-10 bg-blanc rounded-2xl shadow-xl p-5 border-b-4 border-rouge">
                <h3 class="font-poppins font-bold text-lg mb-2">Map inetractive</h3>
                <p class="font-poppins text-sm text-gris">
                    pour trouver les établissement à proximité !
                </p>
            </div>
            <!-- Carte droite : décalée vers le bas -->
            <div class="flex-1 bg-blanc rounded-2xl shadow-md p-4 border-r-4 border-vert mt-12 text-right">
                <p class="font-poppins text-sm leading-loose">
                    De<br />
                    <strong class="text-base">nombreux filtres</strong><br />
                    pour trouver ce qu'il vous faut !
                </p>
            </div>
        </div>
    </div>
</section>
