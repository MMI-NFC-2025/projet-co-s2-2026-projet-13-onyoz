---
const membres = [
    { name: "SPOCK" },
    { name: "ROGER" },
    { name: "VASCO" },
    { name: "JERRY" },
    { name: "LES GALERES" },
];
---

<section class="team-section">
    <h2>La Onyoz' team</h2>
    <div class="team-grille">
        {membres.map(({ name }) => (
            <div class="team-membre">
                <div class="team-photo"></div>
                <span>{name}</span>
            </div>
        ))}
    </div>
</section>

<style>
.team-section {
    padding: 4rem 1.5rem;
    background-color: var(--color-beige);
}

h2 {
    text-align: center;
    font-family: var(--font-kodchasan);
    font-weight: 700;
    font-size: 1.875rem;
    margin-bottom: 3rem;
}

.team-grille {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    max-width: 42rem;
    margin: 0 auto;
}

.team-membre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
}

.team-photo {
    width: 6rem;
    height: 6rem;
    border-radius: 9999px;
    background-color: #e5e7eb;
    overflow: hidden;
}

span {
    font-family: var(--font-poppins);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
}

@media (min-width: 1024px) {
    h2 { font-size: 2.25rem; }
    .team-grille { gap: 3rem; }
}
</style>
