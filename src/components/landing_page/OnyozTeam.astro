---
const membres = [
    { name: "SPOCK" },
    { name: "ROGER" },
    { name: "VASCO" },
    { name: "JERRY" },
    { name: "LES GALERES" },
];
---

<section class="py-16 px-6 bg-beige">
    <h2 class="text-center font-kodchasan font-bold text-3xl lg:text-4xl mb-12">
        La Onyoz' team
    </h2>
    <div class="flex flex-wrap justify-center gap-8 lg:gap-12 max-w-2xl mx-auto">
        {
            membres.map(({ name }) => (
                <div class="flex flex-col items-center gap-3">
                    <div class="w-24 h-24 rounded-full bg-gray-200 overflow-hidden" />
                    <span class="font-poppins text-xs font-bold tracking-widest">{name}</span>
                </div>
            ))
        }
    </div>
</section>
