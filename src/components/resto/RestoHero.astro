---
const { resto } = Astro.props;
const FILE_BASE = "/pb/api/files/pbc_1567773776";
const imgUrl = resto?.images_principale
  ? `${FILE_BASE}/${resto.id}/${resto.images_principale}`
  : "";
---
<div class="relative">
  <img src={imgUrl} alt={resto.nom_restaurants} class="w-full h-56 md:h-72 lg:h-80 object-cover" />

  <div class="absolute inset-0 bg-linear-to-t from-black/30 via-transparent to-transparent"></div>

  <a
    href="/carte"
    class="absolute left-4 top-4 bg-[#98272b]/85 text-white rounded-full w-11 h-11 flex items-center justify-center text-2xl leading-none shadow-md"
    aria-label="Retour a la carte"
  >
    ←
  </a>

  {
    resto?.halal && (
      <span class="absolute right-4 bottom-4 bg-[#6b1f23] text-white text-xs font-semibold rounded-full px-3 py-1.5 shadow-md">
        HALAL
      </span>
    )
  }
</div>