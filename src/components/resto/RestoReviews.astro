---
interface Props {
  avis: unknown;
  restoId?: string;
}

const { avis, restoId } = Astro.props as Props;

interface Review {
  id?: string;
  titre_avis?: string;
  avis?: string;
  note?: number;
  auteur?: string;
  created?: string;
}

const reviews: Review[] = Array.isArray(avis) ? avis : [];

function starsFor(value?: number) {
  const numericValue = typeof value === "number" ? value : 4;
  const safe = Math.min(5, Math.max(0, Math.round(numericValue)));
  return "★".repeat(safe) + "☆".repeat(5 - safe);
}

function formatDate(value?: string) {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "";
  return new Intl.DateTimeFormat("fr-FR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);
}
---
<section aria-labelledby="reviews-title">
  <h2 id="reviews-title" class="font-bold text-2xl mb-3">Notes et avis</h2>

  <ul id="reviews-list" class="grid grid-cols-1 xl:grid-cols-2 gap-3 list-none p-0 m-0" role="list">
    {reviews.length > 0 ? reviews.map((a) => (
      <li>
        <article class="theme-panel-contrast p-4 shadow-md">
          <h3 class="font-bold">{a.titre_avis || 'Avis client'}</h3>
          <p class="text-sm mt-2 leading-relaxed">{a.avis || 'Aucun contenu d avis pour le moment.'}</p>
          <p class="mt-3 text-or text-lg" aria-label={`Note ${typeof a.note === 'number' ? Math.round(a.note) : 4} sur 5`}>
            {starsFor(a.note)}
          </p>
          {a.auteur && (
            <p class="text-xs mt-2 opacity-90">{a.auteur}</p>
          )}
          {a.created && (
            <p class="text-xs mt-1 opacity-90">Publié le {formatDate(a.created)}</p>
          )}
        </article>
      </li>
    )) : (
      <li id="reviews-empty-state">
        <article class="theme-panel-contrast p-4 shadow-md">
          <h3 class="font-bold">Aucun avis pour le moment</h3>
          <p class="text-sm mt-2">Soyez la premiere personne a laisser un commentaire.</p>
        </article>
      </li>
    )}
  </ul>

  <form id="review-form" class="theme-panel-soft mt-4 grid gap-3 p-4" aria-describedby="review-help">
    <fieldset class="grid gap-3 border-0 p-0 m-0">
      <legend class="font-bold text-base">Écrire un commentaire</legend>
      <p id="review-help" class="theme-help text-xs">Les champs marqués d un astérisque sont obligatoires.</p>

      <label for="review-title" class="text-sm">Titre *</label>
      <input
        id="review-title"
        name="titre"
        type="text"
        maxlength="80"
        required
        autocomplete="off"
        class="theme-field rounded-md px-3 py-2"
      />

      <p id="review-auth-hint" class="theme-help text-sm"></p>

      <label for="review-note" class="text-sm">Note *</label>
      <select id="review-note" name="note" required class="theme-field rounded-md px-3 py-2">
        <option value="5">5 sur 5</option>
        <option value="4" selected>4 sur 5</option>
        <option value="3">3 sur 5</option>
        <option value="2">2 sur 5</option>
        <option value="1">1 sur 5</option>
      </select>

      <label for="review-content" class="text-sm">Commentaire *</label>
      <textarea
        id="review-content"
        name="contenu"
        rows="4"
        minlength="8"
        maxlength="800"
        required
        class="theme-field rounded-md px-3 py-2"
      ></textarea>
    </fieldset>

    <button
      id="review-submit"
      type="submit"
      class="theme-btn-accent px-6 py-3 rounded-md w-full"
    >
      Envoyer le commentaire
    </button>

    <p id="review-status" class="text-sm min-h-5" role="status" aria-live="polite"></p>
    <p id="review-error" class="text-sm min-h-5" role="alert" aria-live="assertive"></p>
  </form>
</section>

<script define:vars={{ restoId }}>
  import PocketBase from 'pocketbase';

  const pb = new PocketBase('/pb');
  pb.autoCancellation(false);

  const form = document.getElementById('review-form');
  const statusEl = document.getElementById('review-status');
  const errorEl = document.getElementById('review-error');
  const reviewsList = document.getElementById('reviews-list');
  const submitBtn = document.getElementById('review-submit');
  const authHintEl = document.getElementById('review-auth-hint');

  const toSafeText = (value, fallback = '') => {
    const text = String(value ?? '').trim();
    return text || fallback;
  };

  const toSafeNote = (value) => {
    const parsed = Number(value);
    if (!Number.isFinite(parsed)) return 4;
    return Math.min(5, Math.max(1, Math.round(parsed)));
  };

  const getAuthorLabel = () => {
    const model = pb.authStore.model;
    const name = toSafeText(model?.name);
    if (name) return name;

    const username = toSafeText(model?.username);
    if (username) return username;

    return toSafeText(model?.email, 'Utilisateur Onyoz');
  };

  const starsForClient = (note) => '★'.repeat(note) + '☆'.repeat(5 - note);

  const setStatus = (message) => {
    if (!statusEl || !errorEl) return;
    statusEl.textContent = message;
    errorEl.textContent = '';
  };

  const setError = (message) => {
    if (!statusEl || !errorEl) return;
    statusEl.textContent = '';
    errorEl.textContent = message;
  };

  const setLoading = (isLoading) => {
    if (!submitBtn || !form) return;
    submitBtn.disabled = isLoading;
    submitBtn.textContent = isLoading ? 'Envoi en cours...' : 'Envoyer le commentaire';
    form.setAttribute('aria-busy', String(isLoading));
  };

  const clearReviewsList = () => {
    if (!reviewsList) return;
    reviewsList.innerHTML = '';
  };

  const syncReviewFormAuth = () => {
    const isConnected = pb.authStore.isValid;

    if (authHintEl) {
      authHintEl.textContent = isConnected
        ? `Vous pouvez publier avec le compte ${getAuthorLabel()}.`
        : 'Vous pouvez publier un commentaire sans compte. Si vous etes connecte, votre compte sera seulement utilise comme indication locale.';
    }
  };

  const createReviewCard = (review) => {
    const article = document.createElement('article');
    article.className = 'theme-panel-contrast p-4 shadow-md';

    const title = document.createElement('h3');
    title.className = 'font-bold';
    title.textContent = toSafeText(review.titre_avis, 'Avis client');

    const content = document.createElement('p');
    content.className = 'text-sm mt-2 leading-relaxed';
    content.textContent = toSafeText(review.avis, 'Aucun contenu d avis pour le moment.');

    const noteValue = toSafeNote(review.note);
    const note = document.createElement('p');
    note.className = 'mt-3 text-or text-lg';
    note.setAttribute('aria-label', `Note ${noteValue} sur 5`);
    note.textContent = starsForClient(noteValue);

    article.append(title, content, note);

    const authorLabel = toSafeText(review.auteur);
    if (authorLabel) {
      const author = document.createElement('p');
      author.className = 'text-xs mt-2 opacity-90';
      author.textContent = authorLabel;
      article.appendChild(author);
    }

    if (review.created) {
      const published = document.createElement('p');
      published.className = 'text-xs mt-1 opacity-90';
      published.textContent = `Publié le ${new Intl.DateTimeFormat('fr-FR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      }).format(new Date(review.created))}`;
      article.appendChild(published);
    }

    const item = document.createElement('li');
    item.appendChild(article);
    return item;
  };

  const createEmptyStateCard = () => {
    const item = document.createElement('li');
    item.id = 'reviews-empty-state';

    const article = document.createElement('article');
    article.className = 'theme-panel-contrast p-4 shadow-md';

    const title = document.createElement('h3');
    title.className = 'font-bold';
    title.textContent = 'Aucun avis pour le moment';

    const text = document.createElement('p');
    text.className = 'text-sm mt-2';
    text.textContent = 'Soyez la premiere personne a laisser un commentaire.';

    article.append(title, text);
    item.appendChild(article);
    return item;
  };

  const renderReviews = (reviews) => {
    if (!reviewsList) return;

    clearReviewsList();

    if (!Array.isArray(reviews) || reviews.length === 0) {
      reviewsList.appendChild(createEmptyStateCard());
      return;
    }

    reviews.forEach((review) => {
      reviewsList.appendChild(createReviewCard(review));
    });
  };

  const loadLatestReviews = async () => {
    if (!restoId || !reviewsList) return;

    const latestReviews = await pb.collection('avis').getFullList({
      filter: `restaurants_avis = "${restoId}"`,
      sort: '-created',
    });

    renderReviews(latestReviews);
  };

  if (form && statusEl && errorEl && reviewsList) {
    syncReviewFormAuth();
    pb.authStore.onChange(() => {
      syncReviewFormAuth();
    });

    loadLatestReviews().catch((error) => {
      console.error('Erreur lors du chargement des avis :', error);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!restoId) {
        setError('Impossible d envoyer le commentaire: restaurant introuvable.');
        return;
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      const titre = toSafeText(formData.get('titre'));
      const contenu = toSafeText(formData.get('contenu'));
      const note = toSafeNote(formData.get('note'));

      const payload = {
        titre_avis: titre,
        avis: contenu,
        note,
        restaurants_avis: restoId,
      };

      try {
        setLoading(true);
        setStatus('Envoi en cours...');

        await pb.collection('avis').create(payload);

        const authorLabel = pb.authStore.isValid ? getAuthorLabel() : '';

        await loadLatestReviews();
        form.reset();

        const noteField = form.querySelector('select[name="note"]');
        if (noteField) {
          noteField.value = '4';
        }

        setStatus(
          authorLabel
            ? `Commentaire envoye avec succes sur PocketBase depuis le compte ${authorLabel}.`
            : 'Commentaire envoye avec succes sur PocketBase.'
        );
      } catch (error) {
        console.error('Erreur lors de l envoi du commentaire :', error);
        setError('Erreur lors de l envoi. Reessayez dans un instant.');
      } finally {
        setLoading(false);
      }
    });
  }
</script>