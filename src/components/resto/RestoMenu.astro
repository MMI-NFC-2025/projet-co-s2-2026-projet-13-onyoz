---
const { resto } = Astro.props;

const FILE_BASE = "http://pbonyoz.lucie-garcia.fr/api/files/pbc_1567773776";
const gallery = Array.isArray(resto?.images) ? resto.images.filter(Boolean).slice(0, 2) : [];
const menuLink = resto?.site_web || `https://www.google.com/search?q=${encodeURIComponent(`${resto.nom_restaurants} Montbeliard`)}`;
---
<section>
  <h2 class="font-bold text-2xl">Menu</h2>
  <p class="text-base mt-1">Prix moyen : {resto.prix_moyen} €</p>

  <div class="mt-3 grid grid-cols-2 gap-3">
    {
      gallery.length > 0 ? (
        gallery.map((imageName: string) => (
          <img
            src={`${FILE_BASE}/${resto.id}/${imageName}`}
            alt={`Plat de ${resto.nom_restaurants}`}
            class="w-full h-32 md:h-40 object-cover rounded-lg"
            loading="lazy"
          />
        ))
      ) : (
        <>
          <div class="w-full h-32 md:h-40 bg-gray-200 rounded-lg"></div>
          <div class="w-full h-32 md:h-40 bg-gray-200 rounded-lg"></div>
        </>
      )
    }
  </div>

  <a href={menuLink} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-base underline text-noir hover:text-bordeaux transition">
    → Acceder au menu sur le site web
  </a>
</section>