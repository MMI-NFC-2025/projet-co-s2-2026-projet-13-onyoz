---
import map from "../assets/landing_page/map.avif";
import LogoTxt from "../assets/icons/logo_block(1).svg";
---

<section class="hero">
    <img src={map.src} alt="" aria-hidden="true" class="hero-bg" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <LogoTxt class="hero-logo" />
        <p class="hero-tagline">On épluche les bons plans pour vous !</p>
        <a href="/carte" class="hero-btn">→ Allons y !</a>
    </div>
</section>

<style>
.hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-beige);
}

.hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
}

.hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 2rem;
    gap: 1rem;
}

.hero-logo {
    width: 55vw;
    max-width: 20rem;
    display: block;
}

.hero-tagline {
    color: var(--color-blanc);
    font-family: var(--font-poppins);
    font-style: italic;
    font-size: 1rem;
    margin: 0;
}

.hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--color-vert);
    color: var(--color-blanc);
    font-family: var(--font-poppins);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    text-decoration: none;
    margin-top: 0.5rem;
}

.hero-btn:hover {
    opacity: 0.9;
}

@media (min-width: 1024px) {
    .hero {
        min-height: 90vh;
        padding-bottom: 18%;
    }

    .hero-bg {
        position: absolute;
        top: auto;
        right: auto;
        bottom: 0;
        left: 0;
        width: 100%;
        height: auto;
        object-position: bottom;
    }

    .hero-overlay {
        display: none;
    }

    .hero-content {
        align-items: flex-start;
        text-align: left;
        padding: 0 4rem;
    }

    .hero-logo {
        width: 50vw;
        max-width: 56rem;
        margin-bottom: -3.75rem;
    }

    .hero-tagline {
        font-size: 2.25rem;
        margin-bottom: 2.5rem;
        margin-left: 40%;
    }

    .hero-btn {
        align-self: flex-end;
        font-size: 1.125rem;
        padding: 1rem 2rem;
        margin-top: 0;
    }
}
</style>
