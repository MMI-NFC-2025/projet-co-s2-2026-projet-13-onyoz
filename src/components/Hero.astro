---
import map from "../assets/landing_page/map.avif";
import LogoTxt from "../assets/icons/logo_block(1).svg";
---

<section class="hero">
    <img src={map.src} alt="" aria-hidden="true" class="hero-bg" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <LogoTxt class="hero-logo" />
        <p class="hero-tagline">On épluche les bons plans pour vous !</p>
        <a href="/carte" class="hero-btn">→ Allons y !</a>
    </div>
</section>
