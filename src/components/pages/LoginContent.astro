<main class="min-h-screen bg-beige px-4 py-8 md:py-12">
  <section class="max-w-2xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl md:text-5xl font-bold text-noir">Se connecter</h1>
      <p class="mt-3 text-gris text-base md:text-lg">
        Connectez-vous a votre compte Onyoz.
      </p>
    </div>

    <article class="bg-white rounded-3xl shadow-lg p-6 md:p-8">
      <h2 class="text-2xl font-bold text-noir mb-4">Connexion</h2>

      <form id="login-form" class="space-y-4">
        <label class="block">
          <span class="text-sm font-semibold text-gris">Email ou identifiant</span>
          <input
            id="login-identity"
            name="identity"
            type="text"
            required
            autocomplete="username"
            class="mt-1 w-full rounded-xl border border-black/15 px-4 py-3 outline-none focus:ring-2 focus:ring-bordeaux/40"
            placeholder="vous@exemple.fr ou votre.identifiant"
          />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-gris">Mot de passe</span>
          <input
            id="login-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="mt-1 w-full rounded-xl border border-black/15 px-4 py-3 outline-none focus:ring-2 focus:ring-bordeaux/40"
            placeholder="********"
          />
        </label>

        <div class="flex flex-wrap gap-3 pt-2">
          <button
            type="submit"
            class="bg-bordeaux text-white font-bold px-5 py-3 rounded-xl hover:brightness-95 transition"
          >
            Se connecter
          </button>

          <button
            id="logout-button"
            type="button"
            class="bg-gris text-white font-bold px-5 py-3 rounded-xl hover:brightness-95 transition hidden"
          >
            Se deconnecter
          </button>
        </div>
      </form>

      <p class="mt-4 text-sm text-gris">
        Pas encore de compte ?
        <a href="/creer_compte" class="text-bordeaux font-semibold underline">Creer un compte</a>
      </p>

      <p id="auth-status" class="mt-4 text-sm text-gris">Non connecte.</p>
      <p id="auth-message" class="mt-2 text-sm font-medium"></p>
    </article>
  </section>
</main>

<script type="module">
  import PocketBase from "pocketbase";

  const pb = new PocketBase('/pb');
  pb.autoCancellation(false);

  const loginForm = document.getElementById("login-form");
  const logoutButton = document.getElementById("logout-button");
  const authStatus = document.getElementById("auth-status");
  const authMessage = document.getElementById("auth-message");

  function showMessage(text, kind = "info") {
    if (!authMessage) return;
    authMessage.textContent = text;
    authMessage.className = "mt-2 text-sm font-medium";
    if (kind === "error") authMessage.classList.add("text-bordeaux");
    if (kind === "success") authMessage.classList.add("text-vert");
    if (kind === "info") authMessage.classList.add("text-gris");
  }

  function updateAuthUI() {
    const isConnected = pb.authStore.isValid;
    const accountLabel = pb.authStore.model?.name || pb.authStore.model?.username || pb.authStore.model?.email || "inconnu";

    if (authStatus) {
      authStatus.textContent = isConnected
        ? `Connecte: ${accountLabel}`
        : "Non connecte.";
    }

    if (logoutButton) {
      logoutButton.classList.toggle("hidden", !isConnected);
    }
  }

  updateAuthUI();

  if (loginForm) {
    loginForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(loginForm);

      const identity = String(formData.get("identity") || "").trim();
      const password = String(formData.get("password") || "");

      try {
        await pb.collection("users").authWithPassword(identity, password);
        updateAuthUI();
        showMessage("Connexion reussie. Redirection vers votre compte...", "success");
        setTimeout(() => {
          window.location.href = "/mon_compte";
        }, 800);
      } catch (error) {
        console.error(error);
        showMessage("Echec de connexion. Verifiez votre email, identifiant et mot de passe.", "error");
      }
    });
  }

  pb.authStore.onChange(() => {
    updateAuthUI();
  });

  if (logoutButton) {
    logoutButton.addEventListener("click", () => {
      pb.authStore.clear();
      updateAuthUI();
      showMessage("Deconnexion effectuee.", "info");
    });
  }
</script>
